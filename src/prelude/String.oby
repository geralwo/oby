// String helpers: slicing, building from bytes, and parsing numbers.

// A copy of `s` from `start` up to (not including) `end`. Out-of-range bounds
// are clamped, so a bad slice is empty rather than an error.
String::slice = extern str_slice(String s, int start, int end) -> String

// A String built from `count` bytes of a byte array, starting at `start`.
String::from_bytes = extern str_from_bytes(byte[] bytes, int start, int count) -> String

// Parse the whole text as an integer: decimal, `0x` hex, or `0b` binary, with
// `_` between digits as a separator; surrounding spaces are ignored. Text that
// is not a number gives 0 — there are no exceptions to signal it.
String::to_int = extern str_to_int(String s) -> int
String::to_float = extern str_to_float(String s) -> float

// ------------------------------------------------------------------ //
// Searching, splitting and trimming. These are written in OBY over the
// intrinsic `buffer`/`length` (`str_slice` does the copying).
// ------------------------------------------------------------------ //

// The index of `needle` in `s` at or after `from`, or -1. An empty `needle`
// matches at `from`, clamped to the length.
String::find_from = (String s, String needle, int from) -> int {
	local start = from
	if start < 0 {
		start = 0
	}
	local n = needle.length
	if n == 0 {
		if start > s.length {
			return s.length
		}
		return start
	}
	local last = s.length - n
	while start <= last {
		local j = 0
		local hit = 1
		while j < n {
			if s.buffer[start + j] != needle.buffer[j] {
				hit = 0
				break
			}
			j += 1
		}
		if hit == 1 {
			return start
		}
		start += 1
	}
	return -1
}

// The first index of `needle`, or -1.
String::find = (String s, String needle) -> int {
	return s.find_from(needle, 0)
}

String::contains = (String s, String needle) -> int {
	if s.find(needle) >= 0 {
		return 1
	}
	return 0
}

String::starts_with = (String s, String prefix) -> int {
	if prefix.length > s.length {
		return 0
	}
	return s.find_from(prefix, 0) == 0
}

String::ends_with = (String s, String suffix) -> int {
	local n = suffix.length
	if n > s.length {
		return 0
	}
	return s.find_from(suffix, s.length - n) == s.length - n
}

// The parts of `s` around each `sep`. An empty `sep` gives `s` itself, and
// places where `sep` touches are empty parts (`"a,,b".split(",")` has three).
String::split = (String s, String sep) -> String[] {
	String[] parts = []
	if sep.length == 0 {
		parts.push(s)
		return parts
	}
	local start = 0
	while 1 {
		local i = s.find_from(sep, start)
		if i < 0 {
			parts.push(s.slice(start, s.length))
			return parts
		}
		parts.push(s.slice(start, i))
		start = i + sep.length
	}
	return parts
}

// Whitespace is space, tab, carriage return and newline.
String::trim_start = (String s) -> String {
	local i = 0
	while i < s.length {
		local c = s.buffer[i]
		if c != ' ' and c != '\t' and c != '\r' and c != '\n' {
			break
		}
		i += 1
	}
	return s.slice(i, s.length)
}

String::trim_end = (String s) -> String {
	local i = s.length
	while i > 0 {
		local c = s.buffer[i - 1]
		if c != ' ' and c != '\t' and c != '\r' and c != '\n' {
			break
		}
		i -= 1
	}
	return s.slice(0, i)
}

String::trim = (String s) -> String {
	return s.trim_start().trim_end()
}

// 1 when `s` is empty or only whitespace.
String::is_blank = (String s) -> int {
	if s.trim().length == 0 {
		return 1
	}
	return 0
}

// ------------------------------------------------------------------ //
// Building new text: case conversion, replacement, joining, lines.
// ------------------------------------------------------------------ //

// ASCII case conversion: `A`-`Z` and `a`-`z` only; other bytes copy through.
String::to_lower = (String s) -> String {
	byte[] out = []
	for (local i = 0; i < s.length; i += 1) {
		local c = s.buffer[i]
		if c >= 'A' and c <= 'Z' {
			c += 32
		}
		out.push(c)
	}
	return String::from_bytes(out, 0, out.length)
}

String::to_upper = (String s) -> String {
	byte[] out = []
	for (local i = 0; i < s.length; i += 1) {
		local c = s.buffer[i]
		if c >= 'a' and c <= 'z' {
			c -= 32
		}
		out.push(c)
	}
	return String::from_bytes(out, 0, out.length)
}

// Every occurrence of `from` replaced with `to`, left to right: `"aaa"` with
// `("aa", "b")` is `"ba"`. An empty `from` returns `s` (nothing to find), and
// a replacement is never rescanned.
String::replace = (String s, String from, String to) -> String {
	if from.length == 0 {
		return s
	}
	local out = ""
	local start = 0
	while 1 {
		local i = s.find_from(from, start)
		if i < 0 {
			local rest = s.slice(start, s.length)
			return "${out}${rest}"
		}
		local head = s.slice(start, i)
		out = "${out}${head}${to}"
		start = i + from.length
	}
	return out
}

// The parts joined with `sep` between them, the inverse of `split`.
String::join = (String[] parts, String sep) -> String {
	local out = ""
	for (local i = 0; i < parts.length; i += 1) {
		if i > 0 {
			out = "${out}${sep}"
		}
		local part = parts[i]
		out = "${out}${part}"
	}
	return out
}

// The lines of `s`: split on `\n`, with a trailing `\r` dropped from each line
// (LF and CRLF text give the same lines), and a final newline not counting as
// an empty last line. Empty text has no lines.
String::lines = (String s) -> String[] {
	String[] out = []
	if s.length == 0 {
		return out
	}
	String[] parts = s.split("\n")
	local count = parts.length
	if s.ends_with("\n") {
		count -= 1
	}
	for (local i = 0; i < count; i += 1) {
		local line = parts[i]
		if line.ends_with("\r") {
			line = line.slice(0, line.length - 1)
		}
		out.push(line)
	}
	return out
}