// Snake.
//
//   ./compile.sh run games/snake/main.oby
//
// Arrows or WASD steer, `q` quits.

use "snake.oby"

HORI_TICK_MS = 80
VERT_TICK_MS = 144 // ~1.8x to compensate for tall terminal character cells (1:2 aspect ratio)
Input::raw_mode(1)
Terminal::hide_cursor()
draw_border()
draw_hint()
init(game)



while game.alive {
	Input::poll()
	if Input::is_key_pressed(Input::Key::Q) {
		game.alive = 0
		game.quit = 1
	}
	if Input::is_key_pressed(Input::Key::UP) { set_dir(game, Direction::UP) }
	if Input::is_key_pressed(Input::Key::DOWN) { set_dir(game, Direction::DOWN) }
	if Input::is_key_pressed(Input::Key::LEFT) { set_dir(game, Direction::LEFT) }
	if Input::is_key_pressed(Input::Key::RIGHT) { set_dir(game, Direction::RIGHT) }
	if Input::is_key_pressed(Input::Key::W) { set_dir(game, Direction::UP) }
	if Input::is_key_pressed(Input::Key::S) { set_dir(game, Direction::DOWN) }
	if Input::is_key_pressed(Input::Key::A) { set_dir(game, Direction::LEFT) }
	if Input::is_key_pressed(Input::Key::D) { set_dir(game, Direction::RIGHT) }
	tick(game)

	if game.dir == Direction::UP or game.dir == Direction::DOWN {
		Terminal::sleep_ms(VERT_TICK_MS)
	} else {
		Terminal::sleep_ms(HORI_TICK_MS)
	}

}


if game.quit == 0 {
	draw_game_over(game.score)
	Input::poll()
	while Input::poll() == 0 {
		Terminal::sleep_ms(30)
	}
}

Terminal::clear()
Terminal::show_cursor()
Input::raw_mode(0)
