// Game state and rules.
//
// The state is one object and every function takes it, so nothing lives in
// globals. The snake body is a ring buffer: `head` is the ring index of the
// head, and segment k (0 = head) lives at (head - k + MAXLEN) % MAXLEN.
// Advancing `head` drops the tail for free; eating just increments `len`.
//
// `food` is a `vec2i` member: packed values are stored inline in the object.

use "render.oby"

Direction = enum {
	UP
	DOWN
	LEFT
	RIGHT
}

game = {
	body = [vec2i(); Grid::MAXLEN]
	head = 0
	len = 0
	dir = Direction::RIGHT
	next_dir = Direction::RIGHT
	food = vec2i(0, 0)
	score = 0
	alive = 1
	quit = 0
}

dir_dx = (Direction d) -> int {
	if d == Direction::LEFT { return -1 }
	if d == Direction::RIGHT { return 1 }
	return 0
}

dir_dy = (Direction d) -> int {
	if d == Direction::UP { return -1 }
	if d == Direction::DOWN { return 1 }
	return 0
}

// Segment k, counting from the head.
seg = (game g, int k) -> vec2i {
	return g.body[(g.head - k + Grid::MAXLEN) % Grid::MAXLEN]
}

hits_body = (game g, int x, int y) -> int {
	local k = 0
	while k < g.len {
		local s = seg(g, k)
		if s.x == x and s.y == y { return 1 }
		k += 1
	}
	return 0
}

// Put the food on a free cell.
place_food = (game g) {
	local tries = 0
	while tries < 1000 {
		local fx = rand(Grid::W)
		local fy = rand(Grid::H)
		if hits_body(g, fx, fy) == 0 {
			g.food = vec2i(fx, fy)
			draw_food(fx, fy)
			return
		}
		tries += 1
	}
}

// Buffer a direction change; a 180-degree reversal would run into the neck.
set_dir = (game g, Direction d) {
	if d == Direction::UP and g.dir == Direction::DOWN { return }
	if d == Direction::DOWN and g.dir == Direction::UP { return }
	if d == Direction::LEFT and g.dir == Direction::RIGHT { return }
	if d == Direction::RIGHT and g.dir == Direction::LEFT { return }
	g.next_dir = d
}

init = (game g) {
	g.len = 3
	g.head = 2
	g.body[0] = vec2i(3, 10)
	g.body[1] = vec2i(4, 10)
	g.body[2] = vec2i(5, 10)
	g.dir = Direction::RIGHT
	g.next_dir = Direction::RIGHT
	g.score = 0
	g.alive = 1
	g.quit = 0
	draw_body(3, 10)
	draw_body(4, 10)
	draw_head(5, 10)
	draw_score(0)
	place_food(g)
}

// One step: move the head, then eat or drop the tail.
tick = (game g) {
	g.dir = g.next_dir
	local h = seg(g, 0)
	local nx = h.x + dir_dx(g.dir)
	local ny = h.y + dir_dy(g.dir)

	if nx < 0 or nx >= Grid::W or ny < 0 or ny >= Grid::H {
		g.alive = 0
		return
	}
	if hits_body(g, nx, ny) {
		g.alive = 0
		return
	}

	local tail = seg(g, g.len - 1)
	g.head = (g.head + 1) % Grid::MAXLEN
	g.body[g.head] = vec2i(nx, ny)

	if nx == g.food.x and ny == g.food.y {
		g.len += 1
		g.score += 1
		draw_score(g.score)
		place_food(g)
	} else if tail.x != nx or tail.y != ny {
		erase_cell(tail.x, tail.y)
	}

	draw_body(h.x, h.y)
	draw_head(nx, ny)
}
