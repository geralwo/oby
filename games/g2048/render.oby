// Drawing for 2048. `draw` and `draw_board` are methods on `Game`.

use "g2048.oby"

BOARD_X = 4
BOARD_Y = 3
CELL_W = 7
MSG_Y = 12

cell_color = (int v) -> Terminal::Color {
	if v == 0 { return Terminal::Color::LIGHTBLACK }
	if v == 2 { return Terminal::Color::WHITE }
	if v == 4 { return Terminal::Color::LIGHTWHITE }
	if v == 8 { return Terminal::Color::YELLOW }
	if v == 16 { return Terminal::Color::LIGHTYELLOW }
	if v == 32 { return Terminal::Color::GREEN }
	if v == 64 { return Terminal::Color::LIGHTGREEN }
	if v == 128 { return Terminal::Color::CYAN }
	if v == 256 { return Terminal::Color::LIGHTCYAN }
	if v == 512 { return Terminal::Color::BLUE }
	if v == 1024 { return Terminal::Color::LIGHTBLUE }
	return Terminal::Color::MAGENTA
}

draw_cell = (int x, int y, int v) {
	Terminal::print_at(x, y, "      ")   // clear the field first
	if v != 0 {
		Terminal::set_color(cell_color(v), Terminal::Color::DEFAULT)
		Terminal::print_at(x + 1, y, "${v}")
		Terminal::set_color(Terminal::Color::DEFAULT, Terminal::Color::DEFAULT)
	}
}

Game::draw_board = (Game g) {
	local r = 0
	while r < 4 {
		local c = 0
		while c < 4 {
			draw_cell($BOARD_X + c * $CELL_W, $BOARD_Y + r * 2, g.board[r * 4 + c])
			c += 1
		}
		r += 1
	}
}

draw_message = (String s) {
	Terminal::print_at($BOARD_X, $MSG_Y, "                                        ")
	Terminal::print_at($BOARD_X, $MSG_Y, s)
}

Game::draw = (Game g) {
	Terminal::print_at(0, 0, "2048                                                  ")
	Terminal::print_at(0, 1, "arrows/wasd slide   r restart   q quit                 ")
	Terminal::print_at(0, 2, "score: ${g.score}                                      ")
	g.draw_board()
	if g.over == 1 {
		draw_message("GAME OVER - press r to restart")
	} else {
		draw_message("")
	}
}
