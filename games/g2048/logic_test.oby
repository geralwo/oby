// Non-interactive checks for the 2048 board logic.
//
//   ./build/oby games/g2048/logic_test.oby

use "g2048.oby"

game = Game()

failures = 0

check = (int cond, String label) {
	if cond == 0 {
		$failures += 1
		print("FAIL: ${label}\n")
	}
}

set_row = (int r, int a, int b, int c, int d) {
	$game.board[r * 4 + 0] = a
	$game.board[r * 4 + 1] = b
	$game.board[r * 4 + 2] = c
	$game.board[r * 4 + 3] = d
}

clear_board = () {
	local i = 0
	while i < 16 {
		$game.board[i] = 0
		i += 1
	}
	$game.score = 0
}

// --- merge_line -----------------------------------------------------------
line = [2, 2, 4, 4]
check(merge_line(line) == 12, "merge gain [2,2,4,4]")
check(line[0] == 4 and line[1] == 8 and line[2] == 0 and line[3] == 0, "merge result")

line = [2, 2, 2, 2]
check(merge_line(line) == 8 and line[0] == 4 and line[1] == 4, "two equal pairs")

line = [2, 4, 2, 4]
check(merge_line(line) == 0 and line[0] == 2 and line[3] == 4, "no merge")

line = [0, 0, 0, 2]
check(merge_line(line) == 0 and line[0] == 2 and line[1] == 0, "slide without merge")

line = [4, 4, 8, 8]
check(merge_line(line) == 24 and line[0] == 8 and line[1] == 16, "cascade")

// --- slide ----------------------------------------------------------------
clear_board()
set_row(0, 2, 2, 4, 4)
check(game.slide(Direction::LEFT) == 1, "slide left moved")
check(game.board[0] == 4 and game.board[1] == 8 and game.board[2] == 0, "slide left result")
check(game.score == 12, "slide left score")

clear_board()
set_row(0, 2, 0, 0, 0)
check(game.slide(Direction::LEFT) == 0, "a move to nowhere reports 0")

clear_board()
set_row(0, 2, 0, 0, 0)
check(game.slide(Direction::RIGHT) == 1, "slide right moves")
check(game.board[3] == 2, "slide right lands in the last column")

clear_board()
game.board[0] = 2      // (0, 0)
game.board[4] = 2      // (1, 0)
check(game.slide(Direction::UP) == 1, "slide up moves")
check(game.board[0] == 4 and game.board[4] == 0, "slide up merges at the top")

clear_board()
game.board[0] = 2      // (0, 0)
game.board[4] = 4      // (1, 0)
check(game.slide(Direction::DOWN) == 1, "slide down moves")
check(game.board[8] == 2 and game.board[12] == 4, "slide down keeps order")

// --- spawn ----------------------------------------------------------------
clear_board()
check(game.spawn() == 1, "spawn places a tile")
placed = 0
i = 0
while i < 16 {
	if game.board[i] != 0 { placed += 1 }
	i += 1
}
check(placed == 1, "spawn places exactly one")

clear_board()
r = 0
while r < 4 {
	set_row(r, 2, 4, 2, 4)
	r += 1
}
check(game.spawn() == 0, "spawn on a full board does nothing")

// --- can_move -------------------------------------------------------------
clear_board()
set_row(0, 2, 4, 2, 4)
set_row(1, 4, 2, 4, 2)
set_row(2, 2, 4, 2, 4)
set_row(3, 4, 2, 4, 2)
check(game.can_move() == 0, "a full checkerboard is stuck")

clear_board()
set_row(0, 2, 2, 2, 2)
check(game.can_move() == 1, "an equal neighbour allows a move")

clear_board()
game.board[0] = 2
check(game.can_move() == 1, "an empty cell allows a move")

print("${failures} failures\n")
