// Bitwise operators: `& | ^ ~ << >>`, their compound forms, and Rust-style
// precedence (bitwise binds tighter than comparisons).
// Self-check: `1 / cond` fails the run when a condition is false.

check = (int cond) {
	print(int::to_str(1 / cond))
}

flags = 5
check(flags & 4 != 0)                   // (flags & 4) != 0
check((flags & 2) == 0)
check(flags | 2 == 7)
check(flags ^ 1 == 4)
check(~flags == -6)

check(0xF0 & 0x0F == 0)
check(0xF0 | 0x0F == 0xFF)
check(0xFF ^ 0x0F == 0xF0)
check(0b1010 == 10)
check(0b11 ^ 0b01 == 0b10)
check(byte(0xF0) & 0x0F == 0)            // byte widens into int
check(~byte(0) == 255)                  // `~` keeps the operand's type

// Shifts: looser than `+`, tighter than `&`.
check(1 << 4 == 16)
check(1 << 2 + 3 == 32)
check(1 + 1 << 3 == 16)
check(1 << 2 * 2 == 16)
check(256 >> 4 == 16)
check(0x80 << 1 & 0xFF == 0)
check(1 << 4 | 1 << 2 == 0x14)          // building a mask

// `>>` is arithmetic for signed values and logical for unsigned ones.
check(-8 >> 1 == -4)
check(int64(0) - int64(1) >> 1 == int64(-1))
u = uint(0) - uint(1)
check(u >> 4 == uint(268435455))
big = uint64(1) << 63
check(big >> 63 == uint64(1))

// Compound forms.
f = 0
f |= 4
f |= 1
f &= 5
f ^= 1
check(f == 4)
f <<= 2
f >>= 1
check(f == 8)

// Enum items as masks.
Flags = enum {
	A = uint(1)
	B = 2
	C = 4
}
m = Flags::A | Flags::C
check(uint(m) == 5)
check(m & Flags::A == Flags::A)
check(~Flags::A == uint(4294967294))
