// Closures capture enclosing locals by value (read-only).

check = (int cond) {
	print(int::to_str(1 / cond))
}

// Capture a parameter: partial application.
make_adder = (int n) -> (int) -> int {
	return (int x) -> int { return x + n }
}
add5 = make_adder(5)
check(add5(3) == 8)
check(add5(10) == 15)

// Capture a local computed in the enclosing function.
make_scaler = (int k) -> (int) -> int {
	local factor = k * 2
	return (int x) -> int { return x * factor }
}
check(make_scaler(3)(4) == 24)

// The capture is a snapshot taken when the closure is created.
make_snap = () -> () -> int {
	local n = 1
	local f = () -> int { return n }
	n = 99
	return f
}
snap = make_snap()
check(snap() == 1)

// Mutating through a captured reference value still works.
make_log = () -> () -> int {
	local seen = [0; 0]
	local push = () -> int {
		seen.push(seen.length)
		return seen.length
	}
	return push
}
log = make_log()
check(log() == 1)
check(log() == 2)

// Two levels: the middle function carries the capture through.
outer = () -> int {
	local x = 7
	local mid = () -> int {
		local inner = () -> int { return x }
		return inner()
	}
	return mid()
}
check(outer() == 7)

// A loop-local is captured freshly on each iteration.
run = () -> int {
	local sum = 0
	for (local i = 0; i < 3; i += 1) {
		local f = () -> int { return i }
		sum += f()
	}
	return sum
}
check(run() == 3)
