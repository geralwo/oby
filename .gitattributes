# Line endings are repository policy, not per-machine config: LF in the
# repository, native endings in the working tree. The same files are then
# "clean" for git on Windows and for git under WSL alike, and the toolchain
# tolerates either form (the lexer skips \r; the test harness folds CRLF).
* text=auto

# Vendored code is kept byte-exact: vendor/README.md records a sha256, and a
# checkout must not rewrite the bytes it pins.
vendor/** -text

# A wasm blob is loaded as-is, so it is never rewritten in transit either:
# editors/zed/lspaddon/ carries the extension and its compiled grammar, and
# the stub records what it hashes to.
*.wasm -text
